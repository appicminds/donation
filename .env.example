# Copy to .env.local for local development. Never commit real secrets.

# --- M2: database and CMS (required for /admin) ---
# PostgreSQL connection string. On Vercel, the Neon integration sets this.
DATABASE_URL=postgres://postgres@localhost:5432/comfort_kwaw
# Long random string: openssl rand -hex 32
PAYLOAD_SECRET=
# Only this address can create the first admin account (it becomes super admin).
BOOTSTRAP_ADMIN_EMAIL=
# Vercel Blob token for image uploads in production (local dev stores files in ./media).
# BLOB_READ_WRITE_TOKEN=

# --- M3: anti-abuse and email ---
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# EMAIL_API_KEY=

# --- M4: payments (Stripe TEST keys only until Gate D) ---
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

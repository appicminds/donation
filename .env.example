# Copy to .env.local for local development. Never commit real secrets.

# --- M2: database and CMS (required for /admin) ---
# PostgreSQL connection string. On Vercel, the Neon integration sets this.
DATABASE_URL=postgres://postgres@localhost:5432/comfort_kwaw
# Long random string: openssl rand -hex 32
PAYLOAD_SECRET=
# Only this address can create the first admin account (it becomes super admin).
BOOTSTRAP_ADMIN_EMAIL=
# Vercel Blob token for image uploads in production (local dev stores files in ./media).
# BLOB_READ_WRITE_TOKEN=

# --- M3: visitor forms, anti-abuse and email ---
# Public site URL, used for admin links in staff emails.
# NEXT_PUBLIC_SERVER_URL=https://donation-henna-tau.vercel.app
# Cloudflare Turnstile (optional but recommended in production).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Resend for transactional email (without it, emails are written to the server log).
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=memorial@your-verified-domain.org

# --- M4: payments (Stripe TEST keys only until Gate D) ---
# Secret key (server only). Live keys are refused unless STRIPE_ALLOW_LIVE=true.
# STRIPE_SECRET_KEY=sk_test_...
# Publishable key (safe to expose; baked into the browser bundle at build time).
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Signing secret of the webhook endpoint https://<site>/api/stripe/webhook
# STRIPE_WEBHOOK_SECRET=whsec_...
# Only after owner, legal and processor approval (Gate D):
# STRIPE_ALLOW_LIVE=true
# Local development behind an HTTPS proxy only: lets Node's fetch use HTTPS_PROXY.
# NODE_USE_ENV_PROXY=1
